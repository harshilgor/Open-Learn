{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "predev": "node scripts/build-visual-assets.mjs",
    "prebuild": "node scripts/build-visual-assets.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:visuals": "node --experimental-strip-types --test scripts/visual-intelligence.test.mjs",
    "test:tutor": "vitest run tests/tutor-components.test.tsx",
    "test:agent": "vitest run tests/agent-execution.test.tsx tests/agent-research-sources.test.tsx tests/agent-learning.test.tsx tests/agent-connected-actions.test.tsx tests/browser-assistant.test.tsx tests/responsibilities.test.tsx",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@jetbrains/websandbox": "1.2.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "d3": "7.9.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gsap": "3.15.0",
    "input-otp": "^1.4.2",
    "katex": "^0.18.7",
    "leaflet": "1.9.4",
    "livekit-client": "2.22.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^24.1.3",
    "react-server-dom-webpack": "19.2.6",
