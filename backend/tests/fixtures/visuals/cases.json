 "three_scene": {
  "css": "#scene{width:100%;height:280px;display:block}",
  "html": [
   "<p>Rotating cube</p><canvas id=\"scene\" aria-label=\"Cube\"></canvas>"
  ],
  "jsFunctions": "async function setup(){const THREE=await import('three');const canvas=document.getElementById('scene');const renderer=new THREE.WebGLRenderer({canvas,antialias:true});renderer.setSize(canvas.clientWidth,280,false);const scene=new THREE.Scene();scene.background=new THREE.Color(0x223344);const camera=new THREE.PerspectiveCamera(50,canvas.clientWidth/280,0.1,100);camera.position.z=4;const cube=new THREE.Mesh(new THREE.BoxGeometry(1,1,1),new THREE.MeshNormalMaterial());scene.add(cube);function frame(){cube.rotation.x+=0.01;cube.rotation.y+=0.02;renderer.render(scene,camera);requestAnimationFrame(frame);}frame();}",
  "jsExpressions": [
   "setup().catch(e=>{document.body.append('failed '+e)})"
  ]
 },
