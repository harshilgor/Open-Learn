     "expected": {"f-trivia": "archived"}},
    {"id": "forget-stated-constraint-kept", "advanceDays": 0,
     "facts": [{"key": "f-phone", "kind": "constraint", "statement": "Studies on a phone during the commute.", "days_ago": 1100}],
     "expected": {"f-phone": "active"}, "profile": ["f-phone"]},
    {"id": "forget-tentative-inference-expires", "advanceDays": 0,
