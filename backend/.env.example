# Keep deterministic_baseline until a source policy and provider are approved.
AI_TUTOR_PROVIDER=deterministic_baseline
AI_TUTOR_ENV=development

# Deployed environments must set a PostgreSQL URL. Local development and the
# test suite may use SQLite without running an external database.
DATABASE_URL=sqlite:///backend/data/forma.db
# DATABASE_URL=postgresql+psycopg://ai_tutor:change-me@localhost:5432/ai_tutor

# Backward-compatible local fallback used only when DATABASE_URL is absent.
# FORMA_DB_PATH=backend/data/forma.db

# Development identity is not authentication. Keep non-localhost exposure off
# until a real auth provider derives learner ownership server-side.
AI_TUTOR_DEV_IDENTITY=true

# Hosted ownership uses OIDC JWT access tokens. Configure the same issuer,
# audience, and JWKS URL registered with the web client. Hosted startup fails
# closed when any value is missing or development identity is enabled.
# OPENLEARN_OIDC_ISSUER=https://identity.example.com/
# OPENLEARN_OIDC_AUDIENCE=openlearn-api
# OPENLEARN_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Intent classifier: deterministic local rules by default. Set to "jev" to send
# a bounded text-only context to OpenRouter's Jev Decisions API for ambiguous
# requests. It reuses OPENROUTER_API_KEY; no separate Jev key is required.
# Set to "provider" to use the configured chat-completions provider instead.
AI_TUTOR_MODE_CLASSIFICATION=rules
# AI_TUTOR_JEV_MODEL=typesafe/jev-1.13
# AI_TUTOR_JEV_TIMEOUT_SECONDS=2.5

# Optional OpenRouter lesson provider. Keep the real key in backend/.env or an
# environment variable; it must never be exposed to the browser or committed.
# AI_TUTOR_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OpenRouter uses the free-model router by default. Set this to a specific
# model only when that model is available to your account.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=http://127.0.0.1:3000
# OPENROUTER_APP_NAME=AI Tutor Harness
# OpenAI provider:
# AI_TUTOR_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# Class-session audio transcription uses OpenAI even when text generation uses
# another provider. Set OPENAI_API_KEY for class transcription. General lecture
# recordings retain their existing provider selection; "auto" remains compatible.
# The class pipeline permits only OpenAI and validates this model setting.
# AI_TUTOR_TRANSCRIPTION_PROVIDER=auto
# AI_TUTOR_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Supported batch models: gpt-4o-mini-transcribe, gpt-4o-transcribe, whisper-1.
# Opt-in live captions use a separate OpenAI Realtime session; audio continues
# to be archived locally and batch transcription remains authoritative.
# OPENLEARN_CLASS_LIVE_TRANSCRIPTION_ENABLED=false
# AI_TUTOR_LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Optional, server-side key for explicit read-only YouTube video search inside
# class sessions. Search results are limited to embeddable videos.
# YOUTUBE_DATA_API_KEY=

# Context input estimates. Model windows are exact provider model IDs in JSON.
# AI_TUTOR_MODEL_CONTEXT_WINDOWS={"your-exact-model-id":64000}
# AI_TUTOR_CONTEXT_INPUT_BUDGET_TOKENS=12000
# AI_TUTOR_CONTEXT_OUTPUT_RESERVE_TOKENS=4000
# AI_TUTOR_CONTEXT_SAFETY_TOKENS=1024
# AI_TUTOR_CONTEXT_IMAGE_RESERVE_TOKENS=1200
# Optional exact-model output maximums. Teaching ceilings are Quick 6144,
# Guided 12288, Deep 20480; configured model limits can lower them.
# AI_TUTOR_MODEL_MAX_OUTPUT_TOKENS={"your-exact-model-id":8192}
# Optional semantic retrieval for attached passages and course-scoped notes;
# follows the selected provider and caches embeddings by source content hash.
# OpenRouter model names use provider/model form; a bare OpenAI model name is
# prefixed with openai/ when OpenRouter is selected.
# AI_TUTOR_EMBEDDING_MODEL=text-embedding-3-small

# Bounded web evidence retrieval (Exa behind an internal provider adapter).
# Off by default — set AI_TUTOR_WEB_EVIDENCE=true only after Postgres migrate + smoke tests.
# Never expose EXA_API_KEY to the browser or commit it. See docs/WEB_EVIDENCE_ROLLOUT.md.
# AI_TUTOR_WEB_EVIDENCE=false
# EXA_API_KEY=
# EXA_BASE_URL=https://api.exa.ai
# AI_TUTOR_WEB_PROVIDER=exa
# AI_TUTOR_WEB_KILL_GLOBAL=false
# AI_TUTOR_WEB_KILL_TENANTS=
# AI_TUTOR_WEB_KILL_COURSES=
# AI_TUTOR_WEB_EGRESS_HOSTS=api.exa.ai
# AI_TUTOR_WEB_TIMEOUT_SECONDS=12
# AI_TUTOR_WEB_CONNECT_TIMEOUT_SECONDS=5
# AI_TUTOR_WEB_MAX_RETRIES=1
# AI_TUTOR_WEB_MAX_TOOL_ROUNDS=2
# AI_TUTOR_WEB_MAX_TOOL_CALLS_ROUND=2
# AI_TUTOR_WEB_MAX_RESULTS=5
# AI_TUTOR_WEB_MAX_CHARS=1200
# AI_TUTOR_WEB_MAX_TOTAL_CHARS=6000
# AI_TUTOR_WEB_MAX_SEARCHES_TURN=1
# AI_TUTOR_WEB_MAX_SEARCHES_SESSION=8
# AI_TUTOR_WEB_MAX_SEARCHES_DAY=40
# AI_TUTOR_WEB_MAX_SEARCHES_TENANT_DAY=500
# AI_TUTOR_WEB_MAX_SEARCHES_GLOBAL_DAY=5000
# AI_TUTOR_WEB_MAX_OPENS_SESSION=4
# AI_TUTOR_WEB_MAX_CONCURRENCY=8
# AI_TUTOR_WEB_RESULT_TTL_SECONDS=1800
# AI_TUTOR_WEB_CACHE_TTL_SECONDS=600
# AI_TUTOR_WEB_CIRCUIT_FAILURES=5
# AI_TUTOR_WEB_CIRCUIT_OPEN_SECONDS=60
# AI_TUTOR_WEB_RETENTION_INTERVAL_SECONDS=900
# AI_TUTOR_WEB_ALLOWLIST=
# AI_TUTOR_WEB_DENYLIST=quora.com,brainly.com,coursehero.com,chegg.com
# AI_TUTOR_WEB_ALLOW_MODEL_DOMAINS=false
# RUN_LIVE_EXA_TESTS=false
# General agent admission is opt-in; existing tasks remain readable/cancellable.
OPENLEARN_AGENT_ADMISSION_ENABLED=false
# Separate from transient web-evidence cache TTL; bounded 60 seconds..30 days.
OPENLEARN_RESEARCH_CONTENT_RETENTION_SECONDS=2592000
# Remote sandbox execution is opt-in, lazy, network-blocked and server-only.
OPENLEARN_SANDBOX_ENABLED=false
# Pinned Linux Python snapshot with standard library; no runtime package install.
OPENLEARN_DAYTONA_SNAPSHOT=
OPENLEARN_EXPO_PUSH_ENABLED=false
OPENLEARN_MOBILE_VOICE_ENABLED=false
OPENLEARN_MOBILE_VOICE_DAILY_CALLS=10
DAYTONA_API_KEY=
OPENLEARN_SANDBOX_TIMEOUT_SECONDS=60
OPENLEARN_SANDBOX_LIFETIME_SECONDS=900
OPENLEARN_SANDBOX_OWNER_CREATIONS_DAY=10
OPENLEARN_SANDBOX_GLOBAL_CREATIONS_DAY=100
# Reviewed Google API actions and bounded children are separately opt-in.
OPENLEARN_CONNECTORS_ENABLED=false
OPENLEARN_DELEGATION_ENABLED=false
OPENLEARN_GOOGLE_CLIENT_ID=
OPENLEARN_GOOGLE_CLIENT_SECRET=
# Register exactly this backend callback with Google (HTTPS in production).
OPENLEARN_GOOGLE_REDIRECT_URI=
# Generate a Fernet key server-side; store in a secret manager, never frontend.
OPENLEARN_CONNECTOR_VAULT_KEY=
