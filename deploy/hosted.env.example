AI_TUTOR_ENV=production
AI_TUTOR_DEV_IDENTITY=false
OPENLEARN_MIGRATE_ON_START=false
OPENLEARN_OIDC_ISSUER=https://your-issuer.example
OPENLEARN_OIDC_AUDIENCE=your-api-audience
OPENLEARN_OIDC_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
FORMA_WEB_ORIGIN=https://your-web.example
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# Supabase: copy the exact session pooler URI (port 5432) from Connect.
# Use postgresql+psycopg, sslmode=require, and its postgres.PROJECT_REF username.
# URL-encode the password and store the real URL only in Render secrets.
OPENLEARN_OBJECT_BACKEND=s3
OPENLEARN_OBJECT_BUCKET=your-private-bucket
OPENLEARN_ASSISTANT_S3_BUCKET=your-private-bucket
AWS_DEFAULT_REGION=your-region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENLEARN_OBJECT_ENDPOINT=
OPENLEARN_AGENT_ADMISSION_ENABLED=true
OPENLEARN_EXPO_PUSH_ENABLED=false
# Supply provider, connector encryption/OAuth and resource cap configuration from backend/.env.example.
OPENLEARN_USAGE_MODE=enforce
OPENLEARN_FREE_CREDITS_MICRO=100000000
OPENLEARN_USAGE_WINDOW_SECONDS=18000
OPENLEARN_USAGE_POLICY_VERSION=free-v1
OPENLEARN_USAGE_RATE_VERSION=reference-v1
OPENLEARN_USAGE_PAID_ROUTES_ENABLED=false
# Set a new immutable ID whenever any enabled provider tariff changes.
# OPENLEARN_PROVIDER_RATE_VERSION=provider-rates-YYYY-MM-DD
# Fill with the reviewed provider tariff snapshot identifier before enabling paid routes.
OPENLEARN_PROVIDER_RATE_VERSION=
OPENLEARN_PLATFORM_DAILY_BUDGET_USD=10
OPENLEARN_PLATFORM_MONTHLY_BUDGET_USD=100
# Leave paid-route flags false until each provider rate and resource bound is confirmed.
# Direct transcription is disabled by per-call checks until the deployed rate is
# verified against the configured provider account and model.
# OPENLEARN_OPENAI_STT_USD_PER_MINUTE=
# OPENLEARN_OPENROUTER_STT_USD_PER_MINUTE=
# Jev's optional direct classification API also requires a verified request cap.
# OPENLEARN_JEV_USD_PER_REQUEST=
# Optional research and embeddings also fail closed until account rates are set.
# OPENLEARN_EXA_USD_PER_SEARCH=
# OPENLEARN_EXA_USD_PER_CONTENT_PAGE=
# OPENLEARN_EMBEDDING_USD_PER_MILLION_TOKENS=

# Shared AI provider. Supply the existing private key in the hosting secret store.
AI_TUTOR_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENLEARN_ALLOW_LOCAL_PROVIDER_KEYS=false

# Voice requires OPENLEARN_USAGE_PAID_ROUTES_ENABLED=true, Enforced usage, and
# verified positive rates for LiveKit, Deepgram, and ElevenLabs above. Runtime
# and STT are reserved in 15-second slices; TTS is reserved by utterance length.
OPENLEARN_VOICE_ENABLED=false
# Remains unavailable until live shutdown/background/reconnect acceptance passes.
OPENLEARN_VOICE_LIFECYCLE_VERIFIED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENLEARN_VOICE_MAX_CONCURRENT=20
# Browserbase also requires verified egress and live bounded termination.
OPENLEARN_CLOUD_BROWSER_ENABLED=false
OPENLEARN_BROWSER_EGRESS_VERIFIED=false
OPENLEARN_BROWSER_LIFECYCLE_VERIFIED=false
# Direct realtime class captions bypass server-visible billing and are disabled.
OPENLEARN_CLASS_LIVE_TRANSCRIPTION_ENABLED=false
